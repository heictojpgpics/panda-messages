# Panda Messages environment
#
# Copy to .env and fill in what you have:
#   cp .env.example .env
#
# Everything below is optional. With nothing set the app runs fully in
# local/demo mode: SQLite storage, simulated checkout, demo outbox.
# Each provider switches on independently, with no code changes.

# --- Site -------------------------------------------------------------
# Absolute URL used in emails, card links, sitemap and redirects.
# Set this to your real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Storage: Cloudflare D1 (default: local SQLite file at db/panda.db) -
# Create the database:  npx wrangler d1 create panda-messages
# Create an API token: Cloudflare dashboard > My Profile > API Tokens,
#   with D1 edit permission.
# Then create the tables:  npm run db:init
CLOUDFLARE_ACCOUNT_ID=e4cccf9dea98ae311d7ee30f71fe3754
CLOUDFLARE_API_TOKEN=
D1_DATABASE_ID=c7c00bdc-4d00-47f9-a5cd-e401f64830fa

# --- Private card photos: Cloudflare R2 ---------------------------------
# The production Worker receives this bucket through the CARD_PHOTOS binding
# in wrangler.toml. It stays private: never add a public R2 domain.
# These non-secret values are here for local tooling and operational clarity.
R2_CARD_PHOTOS_BUCKET=panda-message-photos
R2_CARD_PHOTOS_ACCOUNT_ID=e4cccf9dea98ae311d7ee30f71fe3754

# Local SQLite location override (default: db/panda.db)
# SQLITE_PATH=db/panda.db

# --- Payments: Stripe (default: premium simulated checkout) -------------
# Dashboard > Developers > API keys, and a webhook endpoint on
# /api/stripe/webhook subscribed to checkout.session.completed.
# Test card while in test mode: 4242 4242 4242 4242
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email: Resend (default: demo outbox, viewable in the dashboard) ----
# Verify a sender domain first at resend.com/domains.
RESEND_API_KEY=
EMAIL_FROM=Panda <panda@pandamessages.com>

# --- Cron endpoint protection (optional) --------------------------------
# When set, /api/cron/deliveries requires: Authorization: Bearer <secret>
CRON_SECRET=
